# ============================================
# SANCHARIE BACKEND - ENVIRONMENT TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# ⚠️ NEVER commit .env to version control
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8000
NODE_ENV=development

# ============================================
# CORS / ALLOWED ORIGINS
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# MONGODB DATABASE
# ============================================
MONGODB_URI=mongodb://localhost:27017/sancharie

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-secure-jwt-secret-here

# ============================================
# SMS API (MetaReach)
# ============================================
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=your-sender-id
SMS_API_URL=https://sms.metareach.in/vb/apikey.php
SMS_ENTITY_ID=your-dlt-entity-id
SMS_TEMPLATE_ID=your-dlt-template-id

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_MINUTES=5
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_MINUTES=10

# ============================================
# RAZORPAY PAYMENT GATEWAY
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_MERCHANT_NAME=Your Business Name

# ============================================
# ETS (eTravelSmart) BUS BOOKING API - LIVE
# ============================================
# API Documentation: http://partners.etravelsmart.com/bus/busApi.htm
# Live Server: http://agent.etravelsmart.com/etsAPI/api
# 
# Authentication: Digest Authentication
# ============================================

# Live API Configuration
ETS_API_URL=http://agent.etravelsmart.com/etsAPI/api
ETS_API_USERNAME=your-live-username
ETS_API_PASSWORD=your-live-password
ETS_API_TIMEOUT=30000

# Note: Request timeout in milliseconds (default: 30000)

# ============================================
# FLIGHT API (BDSD/TTS)
# ============================================
FLIGHT_API_BASE_URL=https://www.api.bdsd.technology/api
FLIGHT_API_USERNAME=your-flight-api-username
FLIGHT_API_PASSWORD=your-flight-api-password
FLIGHT_API_TIMEOUT=30000
FLIGHT_REQUIRE_PAYMENT=true

# Optional: set only when the provider has assigned a fixed client IP value
# FLIGHT_USER_IP=203.0.113.10

OTP_EXPIRY_MINUTES=5

# Rate limiting: max OTP requests per window
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_MINUTES=10
